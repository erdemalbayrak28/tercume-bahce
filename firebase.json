{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "server.js",
      "package.json",
      "package-lock.json",
      "README.md",
      "nazaybahce/foto/DSC0*",
      "nazaybahce/foto/NAZ0*",
      "nazaybahce/foto/IMG-2025*",
      "nazaybahce/foto/WhatsApp Image*"
    ],
    "redirects": [
      { "source": "/nazaybahce", "destination": "/nazaybahce/", "type": 301 },
      { "source": "/nazaytercume", "destination": "/nazaytercume/", "type": 301 },
      { "source": "/nazay-bahce", "destination": "/nazaybahce/", "type": 301 },
      { "source": "/nazay-bahce/index.html", "destination": "/nazaybahce/", "type": 301 },
      { "source": "/nazay-bahce/:path*", "destination": "/nazaybahce/:path*", "type": 301 },
      { "source": "/nazay", "destination": "/nazaytercume/", "type": 301 },
      { "source": "/nazay/index.html", "destination": "/nazaytercume/", "type": 301 },
      { "source": "/nazay/:path*", "destination": "/nazaytercume/:path*", "type": 301 },
      { "source": "/nazaybahce/index.html", "destination": "/nazaybahce/", "type": 301 },
      { "source": "/nazaytercume/index.html", "destination": "/nazaytercume/", "type": 301 }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "api",
          "region": "europe-west1"
        }
      }
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|png|gif|svg|webp|ico|mp4|woff|woff2|JPG|JPEG|PNG|WEBP|MP4)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=2592000" }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "emulators": {
    "hosting": { "port": 5000 },
    "functions": { "port": 5001 },
    "ui": { "enabled": true }
  }
}
